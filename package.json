{
  "name": "futurcharts",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @futurcharts/demo",
    "build": "npm run build -w @futurcharts/core",
    "typecheck": "tsc -p packages/core --noEmit && tsc -p packages/adapters --noEmit && tsc -p apps/demo --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
