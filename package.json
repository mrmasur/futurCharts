{
  "name": "futurcharts",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @futurcharts/demo",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p packages/core && tsc -p packages/adapters && tsc -p packages/geo && tsc -p packages/element && tsc -p packages/react && tsc -p packages/vue && tsc -p packages/ember && tsc -p apps/demo --noEmit && tsc -p apps/storybook && tsc -p tests/visual",
    "test": "vitest run",
    "storybook": "npm run storybook -w @futurcharts/storybook",
    "stories": "npm run stories -w @futurcharts/storybook",
    "test:visual": "vite-node --config apps/demo/vite.config.ts tests/visual/liste.ts && playwright test --project=bureau --project=sombre --project=mobile --project=mobile-haut",
    "test:visual:update": "npm run test:visual -- --update-snapshots",
    "verif": "npm run typecheck && npm run test && npm run build && npm run test:visual && npm run test:robustesse && npm run test:interactions",
    "prepare": "git config core.hooksPath .githooks",
    "test:robustesse": "vite-node --config apps/demo/vite.config.ts tests/visual/liste.ts && playwright test --project=robustesse",
    "test:interactions": "vite-node --config apps/demo/vite.config.ts tests/visual/liste.ts && playwright test --project=interactions",
    "schema": "node scripts/schema.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "ajv": "^8.20.0",
    "apache-arrow": "^21.2.0",
    "ember-modifier": "^4.2.0",
    "ember-source": "^5.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-json-schema-generator": "^2.4.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0",
    "vue": "^3.5.0"
  }
}
