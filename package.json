{
  "name": "futurcharts",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @futurcharts/demo",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p packages/core && tsc -p packages/adapters && tsc -p packages/geo && tsc -p packages/element && tsc -p packages/react && tsc -p packages/vue && tsc -p packages/ember && tsc -p apps/demo --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "vue": "^3.5.0",
    "ember-modifier": "^4.2.0",
    "ember-source": "^5.12.0"
  }
}
