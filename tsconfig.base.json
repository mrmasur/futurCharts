{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "paths": {
      "@futurcharts/*": [
        "./packages/*/src/index.ts"
      ]
    }
  }
}
